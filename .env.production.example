# ============================================================================
# Settings for the VPS (steps 44–48) — a TEMPLATE with no real values.
# On the server, TWO filled-in copies (then `chmod 600` each):
#   /opt/nowoll/.env          production
#   /opt/nowoll-staging/.env  staging: staging Supabase project, SSLCommerz sandbox,
#                             its own REDIS_PASSWORD, staging addresses, Meta off
# NEVER commit the real file; never paste these values in chat or email.
# Guide: docs/deployment.md. The shop's and admin's public addresses are baked in
# by GitHub (repository variables, also in that guide).
# ============================================================================

NODE_ENV=production

# ── Addresses ────────────────────────────────────────────────────────────────
# Nginx serves all six (DNS records → the VPS, through Cloudflare —
# docs/integrations/cloudflare.md). Nginx reads them from the PRODUCTION file
# only; keep the same six lines in both files anyway.
SITE_DOMAIN=nowoll.com
ADMIN_DOMAIN=admin.nowoll.com
API_DOMAIN=api.nowoll.com
STAGING_SITE_DOMAIN=staging.nowoll.com
STAGING_ADMIN_DOMAIN=admin.staging.nowoll.com
STAGING_API_DOMAIN=api.staging.nowoll.com

# The TRIAL PASSWORD on the production shop before launch: on | off.
# (Production file only. Staging always asks. Usernames: /opt/nowoll/htpasswd —
# docs/deployment.md.) Switch to off when the ads start.
SITE_PASSWORD=on

# The API's own address, and where it sends customers back to.
API_PUBLIC_URL=https://api.nowoll.com
NEXT_PUBLIC_SITE_URL=https://nowoll.com
NEXT_PUBLIC_ADMIN_URL=https://admin.nowoll.com
# Only these sites may call the API from a browser (comma-separated, never *).
ALLOWED_ORIGIN=https://nowoll.com,https://admin.nowoll.com
# Login cookies shared by nowoll.com and api.nowoll.com.
# Staging: COOKIE_DOMAIN=.staging.nowoll.com and COOKIE_PREFIX=nws.
COOKIE_DOMAIN=.nowoll.com
# The start of the cookies' names: nw (production) / nws (staging), so a
# staging sign-in never mixes with production's.
COOKIE_PREFIX=nw

# ── The shop's own server → the API (SECRET; `openssl rand -hex 32`) ───────
# Its page builds skip the per-visitor rate limit. A different one per file.
INTERNAL_API_KEY=

# ── Database (Supabase → Connect → "Session pooler" URI — docs/integrations/supabase.md) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (inside Docker; any long random text, e.g. `openssl rand -hex 32`) ──
REDIS_PASSWORD=
# (REDIS_URL is built from REDIS_PASSWORD by docker-compose.prod.yml.)

# ── Payments: SSLCommerz (docs/integrations/sslcommerz.md) — SECRET ───────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=true

# Steadfast Courier (docs/integrations/courier.md) — from the Steadfast merchant dashboard →
# "API and plugins". SECRET: only in this file on the server, never in the admin or in git.
# Empty = "Book with Steadfast" says it isn't connected (tracking numbers by hand still work).
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Email: Resend (docs/integrations/resend.md) — SECRET ─────────────────────
# REQUIRED: the workers refuse to start without a real key (re_…) and EMAIL_ADMIN.
RESEND_API_KEY=
EMAIL_FROM=Nowoll <orders@mail.nowoll.com>
EMAIL_ADMIN=
# Newsletter unsubscribes from Resend (step 42). Empty = webhook off.
RESEND_WEBHOOK_SECRET=

# ── Meta Conversions API (docs/integrations/meta.md) — SECRET. Empty = off. ─
META_CAPI_ACCESS_TOKEN=

# ── Error tracking (Phase 7) ────────────────────────────────────────────────
SENTRY_DSN=
