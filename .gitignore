# ================================================
# NOWOLL — .gitignore
# ================================================

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/
out/
**/.next/
**/dist/
**/build/

# pnpm
.pnpm-store/
pnpm-debug.log*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
*.pid
*.seed
*.pid.lock
pids/

# Coverage
coverage/
.nyc_output/

# IDE
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Prisma — generated client (regenerated on install)
**/prisma/generated/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Temporary
tmp/
temp/

# Windows download metadata (created when copying files from Windows into WSL)
*:Zone.Identifier

# Turborepo local cache
.turbo/

# Prisma 7 generated client (rebuilt by `pnpm db:generate`)
packages/database/src/generated/

# Next.js generated files
next-env.d.ts
*.tsbuildinfo
