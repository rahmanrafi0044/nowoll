{
  "name": "@nowoll/payments",
  "version": "0.0.0",
  "private": true,
  "description": "Payment provider adapters (SSLCommerz, Cash on Delivery) behind one PaymentProvider interface",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sandbox-check": "node --env-file-if-exists=../../.env --import tsx scripts/sandbox-check.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
