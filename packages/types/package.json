{
  "name": "@nowoll/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types for API responses and domain data (used by api, storefront, admin)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nowoll/database": "workspace:*"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
