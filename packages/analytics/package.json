{
  "name": "@nowoll/analytics",
  "version": "0.0.0",
  "private": true,
  "description": "Tracking: customer consent, GA4 / GTM / Meta Pixel event builders, browser senders; ./server — Meta Conversions API (hashing, sending)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
