{
  "name": "@nowoll/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod validation schemas (phone, email, slug, money, address) used on frontend and backend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "./dist/jitless.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
