{
  "name": "@nowoll/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations and the shared database client",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:seed": "prisma db seed",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/pg": "^8.23.0",
    "dotenv": "^18.0.0",
    "prisma": "7.10.0",
    "eslint": "^10.12.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "@types/node": "^24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
