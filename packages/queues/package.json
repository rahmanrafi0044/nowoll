{
  "name": "@nowoll/queues",
  "version": "0.0.0",
  "private": true,
  "description": "Background job contracts (BullMQ): queue names, job data, retry rules — shared by the API and the workers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "bullmq": "^6.3.16",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
