{
  "name": "@nowoll/api",
  "version": "0.0.0",
  "private": true,
  "description": "Nowoll REST API (NestJS) \u2014 served at /api/v1",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "admin": "node --env-file-if-exists=../../.env --import tsx scripts/admin-access.ts",
    "clean": "rm -rf dist .turbo",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "seed:demo": "node --env-file-if-exists=../../.env --import tsx scripts/seed-demo.ts",
    "start": "node dist/main.js",
    "storage:setup": "node --env-file-if-exists=../../.env --import tsx scripts/setup-storage.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nowoll/analytics": "workspace:*",
    "@nowoll/database": "workspace:*",
    "@nowoll/payments": "workspace:*",
    "@nowoll/queues": "workspace:^",
    "@nowoll/types": "workspace:*",
    "@nowoll/validation": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@nowoll/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
