{
  "name": "@nowoll/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Nowoll admin panel (Next.js) — admin.nowoll.com",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next .turbo"
  },
  "dependencies": {
    "@nowoll/types": "workspace:*",
    "@nowoll/ui": "workspace:*",
    "@nowoll/validation": "workspace:*",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
