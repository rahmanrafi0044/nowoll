{
  "name": "@nowoll/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser tests (Playwright) of the real storefront, admin panel + API against a throwaway database",
  "type": "module",
  "scripts": {
    "test:e2e": "node --import tsx run-e2e.ts",
    "lighthouse": "node --import tsx run-lighthouse.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nowoll/analytics": "workspace:*",
    "@nowoll/api": "workspace:*",
    "@nowoll/config": "workspace:*",
    "@nowoll/database": "workspace:*",
    "@nowoll/notification-worker": "workspace:*",
    "@nowoll/ui": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "lighthouse": "13.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.0",
    "typescript": "6.0.3"
  }
}
