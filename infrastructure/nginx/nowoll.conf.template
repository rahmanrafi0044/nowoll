# ============================================================================
# Nginx in front of the Nowoll API — steps 46–47. ONLY Nginx is reachable from
# the internet (ports 80 and 443); the APIs, workers and Redis stay on Docker's
# private networks. One nginx serves both copies of the API:
#   ${API_DOMAIN}          → production (api-production)
#   ${STAGING_API_DOMAIN}  → staging    (api-staging)
#
# A TEMPLATE: when the container starts, the official nginx image fills in
# ${API_DOMAIN} and ${STAGING_API_DOMAIN} from the environment and writes the
# result to /etc/nginx/conf.d/default.conf (replacing the image's stock site).
# Nginx's own $variables are left alone.
# Certificates: ONE Let's Encrypt certificate for both names, stored under
# ${API_DOMAIN} (certbot, step 49 — docs/deployment.md).
# ============================================================================

# Docker's own DNS. Every deploy creates a NEW api container with a new
# address, so nginx must look the API up again (every 10 s) instead of keeping
# the address it found at start-up — otherwise: 502 after each deploy. It also
# lets nginx start while one of the APIs isn't running (502 for that one only).
resolver 127.0.0.11 valid=10s ipv6=off;

# Each API trusts ONE proxy hop ('trust proxy' 1) — this one — for the real IP.
# "zone" is shared memory, needed by "resolve" (nginx ≥ 1.27.3).
upstream nowoll_api_production {
    zone nowoll_api_production 64k;
    server api-production:3001 resolve;
    keepalive 16;
}
upstream nowoll_api_staging {
    zone nowoll_api_staging 64k;
    server api-staging:3001 resolve;
    keepalive 8;
}

# Which API answers, by the domain asked for (anything else → production).
map $host $nowoll_api {
    ${STAGING_API_DOMAIN}  nowoll_api_staging;
    default                nowoll_api_production;
}

# An outer rate limit per visitor (a first shield; the API has finer limits,
# e.g. 5/min on sign-in and payments). 20 requests/second, bursts of 40.
limit_req_zone $binary_remote_addr zone=per_ip:10m rate=20r/s;
limit_req_status 429;

# Don't say which nginx version runs here.
server_tokens off;

# ── Port 80: only the certificate check, everything else → HTTPS ────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN} ${STAGING_API_DOMAIN};

    # Let's Encrypt proves we own the domain by fetching a file from here.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── Port 443: the APIs ────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN} ${STAGING_API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    # Modern TLS only (Mozilla "intermediate" settings).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Browsers: always use HTTPS for this domain for 2 years. The API's own
    # Helmet middleware adds the other security headers; its shorter HSTS
    # header is hidden below so browsers get exactly one.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Photo uploads are at most 5 MB (the API checks); a little room for the form around them.
    client_max_body_size 6m;
    client_body_timeout 30s;

    gzip on;
    gzip_types application/json text/plain text/csv;
    gzip_min_length 1024;

    # Only the API lives here; everything else is "not found".
    location /api/ {
        limit_req zone=per_ip burst=40 nodelay;

        proxy_pass http://$nowoll_api;
        proxy_hide_header Strict-Transport-Security;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # The visitor's real address (the API's rate limits and Meta events use it).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        return 404;
    }
}
