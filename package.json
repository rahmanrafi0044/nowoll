{
  "name": "nowoll",
  "version": "1.0.0",
  "description": "Nowoll \u2014 always new | E-commerce clothing store (Bangladesh)",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=3",
    "test:e2e": "turbo run test:e2e",
    "lighthouse": "pnpm --filter @nowoll/e2e lighthouse --",
    "db:generate": "turbo run db:generate --filter=@nowoll/database",
    "db:migrate": "turbo run db:migrate --filter=@nowoll/database",
    "db:studio": "turbo run db:studio --filter=@nowoll/database",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:grant": "pnpm --filter @nowoll/api admin grant",
    "admin:revoke": "pnpm --filter @nowoll/api admin revoke",
    "admin:reset-2fa": "pnpm --filter @nowoll/api admin reset-2fa",
    "storage:setup": "pnpm --filter @nowoll/api storage:setup",
    "db:seed:demo": "pnpm --filter @nowoll/api seed:demo --",
    "payments:sandbox-check": "pnpm --filter @nowoll/payments sandbox-check",
    "email:preview": "pnpm --filter @nowoll/email preview"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "eslint": "^9.39.0",
    "prettier": "^3.9.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "mysql2": "3.24.5"
    }
  }
}
