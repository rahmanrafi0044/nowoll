{
  "name": "@nowoll/notification-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: account, newsletter, return, refund and shipping emails (BullMQ) \u2014 CLAUDE.md \u00a710",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nowoll/analytics": "workspace:*",
    "@nowoll/database": "workspace:*",
    "@nowoll/email": "workspace:*",
    "@nowoll/queues": "workspace:*",
    "@nowoll/validation": "workspace:*",
    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@nowoll/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
