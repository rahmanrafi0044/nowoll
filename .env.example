# ================================================
# NOWOLL — Environment Variables
# Copy this to .env and fill in real values
# NEVER commit .env to git — it's in .gitignore
# ================================================

# ─── Local Database (Docker) ───────────────────
DATABASE_URL=postgresql://nowoll:nowoll_local_password@localhost:5432/nowoll_dev

# ─── Redis (Docker) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Supabase ──────────────────────────────────
# Settings → API in your Supabase dashboard
# After filling these in, run once: pnpm storage:setup  (creates the product-images bucket)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY — never in client bundle. Used by the API to upload product images.

# ─── SSLCommerz ────────────────────────────────
# Sandbox: https://developer.sslcommerz.com/registration/
# Live: from your SSLCommerz merchant dashboard after approval
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false   # Set true ONLY in production

# Steadfast Courier (docs/integrations/courier.md) — from the Steadfast merchant dashboard →
# "API and plugins". SECRET: only in this file on the server, never in the admin or in git.
# Empty = "Book with Steadfast" says it isn't connected (tracking numbers by hand still work).
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Dashboard → Webhook → Auth token (also typed into the dashboard). Empty = delivery updates off.
STEADFAST_WEBHOOK_TOKEN=

# Meta Conversions API (step 39b — docs/integrations/meta.md → "Getting the access token").
# SECRET: server only, never in the admin panel. Empty = server events are skipped.
META_CAPI_ACCESS_TOKEN=

# Resend webhook (step 42 — newsletter unsubscribes from Resend come back to us).
# SECRET, server only. Resend → Webhooks → your endpoint → signing secret (whsec_…). Empty = webhook off.
RESEND_WEBHOOK_SECRET=
# The API's public address — SSLCommerz posts payment notifications here (https in production)
API_PUBLIC_URL=http://localhost:3001
# Which site the login cookies belong to. Production: .nowoll.com (shop + API share them). Development: leave empty.
COOKIE_DOMAIN=
# Placeholders are fine in development; the API refuses to start in production without real values.
# Check the sandbox connection: pnpm payments:sandbox-check  (one ৳10 sandbox session, no real money)

# ─── Email (Resend) — docs/integrations/resend.md ────────────
# Production sends through Resend. Development ALWAYS uses Mailpit (below),
# even if a real key is here — unless EMAIL_USE_RESEND=true (on purpose).
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Nowoll <orders@mail.nowoll.com>"   # a verified Resend (sub)domain
EMAIL_ADMIN=rafi@nowoll.com   # Admin alerts (low stock) — used only when Admin → Settings → Admin alert email is empty
EMAIL_USE_RESEND=false

# ─── JWT Authentication ────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-64-character-random-string
JWT_EXPIRES_IN=8h

# ─── App URLs ──────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3002

# ─── Analytics ─────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ─── Sentry ────────────────────────────────────
# https://sentry.io → your project → Settings → Client Keys
SENTRY_DSN=https://xxxx@sentry.io/xxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── NestJS App ────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Email Testing (Mailpit — local dev only) ──
# Development emails go to Mailpit over SMTP (docker compose up -d mailpit).
# Nothing reaches a real inbox. Read them at: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
